import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export component SendBar inherits FocusScope {
    // 有错误提示时加高一行，避免红字被裁半
    height: root.error-hint == "" ? 44px : 62px;
    forward-focus: input;

    in property <string> error-hint;
    in-out property <string> input-text;
    // ending / hex 由上方 Toolbar 控制，经 App 属性传入
    in property <int> ending-index;  // 0=Cr 1=Lf 2=Crlf 3=None
    in property <bool> is-hex;

    callback send(string, int, int);  // text, mode(0/1), ending(0..3)
    callback history-prev();
    callback history-next();

    Rectangle {
        background: Theme.panel;
        border-color: Theme.border;
        border-width: 1px;
        clip: false;

        VerticalLayout {
            spacing: 2px;
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 4px;
            padding-bottom: 4px;

            HorizontalLayout {
                spacing: 6px;
                input := LineEdit {
                    placeholder-text: "输入命令，Enter 发送（↑↓ 调历史）";
                    text <=> root.input-text;
                    horizontal-stretch: 1;
                    accepted => {
                        root.send(root.input-text, root.is-hex ? 1 : 0, root.ending-index);
                    }
                }
                Button {
                    text: "发送";
                    primary: true;
                    height: Theme.control-height;
                    width: 72px;
                    clicked => {
                        root.send(root.input-text, root.is-hex ? 1 : 0, root.ending-index);
                    }
                }
            }

            if root.error-hint != "": Text {
                text: root.error-hint;
                color: Theme.text-error;
                font-size: 12px;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }

    key-pressed(e) => {
        if e.text == Key.UpArrow {
            root.history-prev();
            accept
        } else if e.text == Key.DownArrow {
            root.history-next();
            accept
        } else {
            reject
        }
    }
}
