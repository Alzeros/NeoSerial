import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";
import { SegButton } from "seg-button.slint";

export component SendBar inherits FocusScope {
    height: 56px;
    forward-focus: input;

    in property <string> error-hint;
    in-out property <string> input-text;
    in-out property <int> ending-index;  // 0=Cr 1=Lf 2=Crlf 3=None
    in-out property <bool> is-hex;

    callback send(string, int, int);  // text, mode(0/1), ending(0..3)
    callback history-prev();
    callback history-next();

    Rectangle {
        background: Theme.panel;

        VerticalLayout {
            spacing: 4px;
            padding: 6px;

            HorizontalLayout {
                spacing: 8px;
                input := LineEdit {
                    placeholder-text: "输入命令，回车发送（↑↓ 调历史）";
                    text <=> root.input-text;
                    horizontal-stretch: 1;
                    accepted => {
                        root.send(root.input-text, root.is-hex ? 1 : 0, root.ending-index);
                    }
                }
                SegButton {
                    options: ["CR", "LF", "CRLF", "无"];
                    current: root.ending-index;
                    selected(i) => { root.ending-index = i; }
                }
                Button {
                    text: root.is-hex ? "HEX ✓" : "HEX";
                    clicked => { root.is-hex = !root.is-hex; }
                }
                Button {
                    text: "发送";
                    primary: true;
                    clicked => {
                        root.send(root.input-text, root.is-hex ? 1 : 0, root.ending-index);
                    }
                }
            }

            if root.error-hint != "": Text {
                text: root.error-hint;
                color: Theme.text-error;
                font-size: 11px;
            }
        }
    }

    key-pressed(e) => {
        if e.text == Key.UpArrow {
            root.history-prev();
            accept
        } else if e.text == Key.DownArrow {
            root.history-next();
            accept
        } else {
            reject
        }
    }
}
