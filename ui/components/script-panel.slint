import { ListView, Button, LineEdit, ComboBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export struct CommandItemSlint {
    label: string,
    content: string,
    mode: int,
    ending: int,
    enabled: bool,
}

export struct CommandGroupSlint {
    name: string,
    items: [CommandItemSlint],
}

/// 右侧命令脚本面板，可折叠；新增/编辑用内嵌表单。
export component ScriptPanel inherits Rectangle {
    background: Theme.panel;
    clip: true;
    width: root.collapsed ? 28px : 280px;
    horizontal-stretch: 0;

    in-out property <[CommandGroupSlint]> groups;
    in-out property <int> current-group: 0;
    in-out property <bool> collapsed: false;

    // 编辑表单状态
    property <bool> editing: false;
    property <bool> edit-is-new: true;   // true=新增 false=改已有
    property <int> edit-group: 0;
    property <int> edit-index: 0;
    property <string> edit-label: "";
    property <string> edit-content: "";
    property <int> edit-mode: 0;         // 0=ASCII 1=HEX
    property <int> edit-ending: 2;       // 0=CR 1=LF 2=CRLF 3=无

    callback send-command(int, int);
    callback add-command(string, string, int, int);                 // label, content, mode, ending
    callback update-command(int, int, string, string, int, int);    // g, i, label, content, mode, ending
    callback delete-command(int, int);

    function open-add() {
        root.edit-is-new = true;
        root.edit-group = root.current-group;
        root.edit-index = 0;
        root.edit-label = "";
        root.edit-content = "";
        root.edit-mode = 0;
        root.edit-ending = 2;
        root.editing = true;
    }

    function open-edit(g: int, i: int, label: string, content: string, mode: int, ending: int) {
        root.edit-is-new = false;
        root.edit-group = g;
        root.edit-index = i;
        root.edit-label = label;
        root.edit-content = content;
        root.edit-mode = mode;
        root.edit-ending = ending;
        root.editing = true;
    }

    function confirm-edit() {
        if root.edit-is-new {
            root.add-command(root.edit-label, root.edit-content, root.edit-mode, root.edit-ending);
        } else {
            root.update-command(root.edit-group, root.edit-index, root.edit-label, root.edit-content, root.edit-mode, root.edit-ending);
        }
        root.editing = false;
    }

    HorizontalLayout {
        spacing: 0px;

        Rectangle { width: 1px; background: Theme.border; }

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            // ===== 标题栏 =====
            Rectangle {
                height: 28px;
                background: Theme.panel-light;
                HorizontalLayout {
                    padding-left: root.collapsed ? 0px : 8px;
                    padding-right: root.collapsed ? 0px : 4px;
                    spacing: 4px;

                    if root.collapsed : TouchArea {
                        horizontal-stretch: 1;
                        clicked => { root.collapsed = false; }
                        Text {
                            text: ">>";
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: Theme.font-ui-size;
                        }
                    }

                    if !root.collapsed : Text {
                        text: "命令脚本";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        font-size: Theme.font-ui-size;
                        horizontal-stretch: 1;
                        horizontal-alignment: left;
                    }

                    if !root.collapsed : Button {
                        text: "<<";
                        width: 32px;
                        height: Theme.control-height;
                        clicked => {
                            root.editing = false;
                            root.collapsed = true;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // ===== 折叠态 =====
            if root.collapsed : TouchArea {
                vertical-stretch: 1;
                clicked => { root.collapsed = false; }
                VerticalLayout {
                    padding-top: 10px;
                    spacing: 2px;
                    alignment: start;
                    Text {
                        text: "脚";
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        font-size: Theme.font-ui-size;
                    }
                    Text {
                        text: "本";
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        font-size: Theme.font-ui-size;
                    }
                }
            }

            // ===== 展开 + 非编辑：Tab / 列表 / 新增 =====
            if !root.collapsed && !root.editing : HorizontalLayout {
                spacing: 0px;
                height: 28px;
                for g[i] in root.groups : TouchArea {
                    width: 72px;
                    height: 28px;
                    clicked => { root.current-group = i; }
                    Rectangle {
                        background: i == root.current-group ? Theme.bg : Theme.panel;
                        Text {
                            text: g.name;
                            color: i == root.current-group ? #e6edf3 : Theme.text-muted;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            x: 8px;
                            font-size: Theme.font-ui-size;
                        }
                        if i == root.current-group : Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            width: 100%;
                            background: Theme.accent;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: Theme.panel; }
            }

            if !root.collapsed && !root.editing : Rectangle { height: 1px; background: Theme.border; }

            if !root.collapsed && !root.editing : ListView {
                vertical-stretch: 1;
                for g[gi] in root.groups : Rectangle {
                    height: gi == root.current-group ? (g.items.length * 34px) : 0px;
                    clip: true;
                    VerticalLayout {
                        spacing: 0px;
                        for item[ii] in g.items : Rectangle {
                            height: 34px;
                            background: Math.mod(ii, 2) == 0 ? Theme.panel : Theme.panel-alt;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 4px;
                                spacing: 4px;
                                // 左对齐：不设 alignment: center
                                Button {
                                    height: Theme.control-height;
                                    text: item.label;
                                    horizontal-stretch: 1;
                                    primary: true;
                                    clicked => { root.send-command(gi, ii); }
                                }
                                Button {
                                    height: Theme.control-height;
                                    text: "改";
                                    width: 32px;
                                    clicked => {
                                        root.open-edit(gi, ii, item.label, item.content, item.mode, item.ending);
                                    }
                                }
                                Button {
                                    height: Theme.control-height;
                                    text: "删";
                                    width: 32px;
                                    clicked => { root.delete-command(gi, ii); }
                                }
                            }
                        }
                    }
                }
            }

            if !root.collapsed && !root.editing : Rectangle {
                height: 36px;
                background: Theme.panel-light;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    Button {
                        height: Theme.control-height;
                        text: "+ 新增命令";
                        horizontal-stretch: 1;
                        clicked => { root.open-add(); }
                    }
                }
            }

            // ===== 展开 + 编辑表单 =====
            if !root.collapsed && root.editing : VerticalLayout {
                spacing: 6px;
                padding: 8px;
                vertical-stretch: 1;

                Text {
                    text: root.edit-is-new ? "新增命令" : "编辑命令";
                    color: #e6edf3;
                    font-size: Theme.font-ui-size;
                    horizontal-alignment: left;
                }

                Text {
                    text: "标签";
                    color: Theme.text-muted;
                    font-size: Theme.font-ui-size;
                    horizontal-alignment: left;
                }
                LineEdit {
                    height: Theme.control-height;
                    text <=> root.edit-label;
                    placeholder-text: "按钮显示名，如 AT";
                }

                Text {
                    text: "内容";
                    color: Theme.text-muted;
                    font-size: Theme.font-ui-size;
                    horizontal-alignment: left;
                }
                LineEdit {
                    height: Theme.control-height;
                    text <=> root.edit-content;
                    placeholder-text: "实际发送内容，如 AT+CSQ";
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "模式";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        font-size: Theme.font-ui-size;
                        width: 36px;
                        horizontal-alignment: left;
                    }
                    ComboBox {
                        height: Theme.control-height;
                        horizontal-stretch: 1;
                        model: ["ASCII", "HEX"];
                        current-value: root.edit-mode == 1 ? "HEX" : "ASCII";
                        selected => {
                            root.edit-mode = self.current-value == "HEX" ? 1 : 0;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "行尾";
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        font-size: Theme.font-ui-size;
                        width: 36px;
                        horizontal-alignment: left;
                    }
                    ComboBox {
                        height: Theme.control-height;
                        horizontal-stretch: 1;
                        model: ["CR", "LF", "CRLF", "无"];
                        current-value: root.edit-ending == 0 ? "CR" : root.edit-ending == 1 ? "LF" : root.edit-ending == 2 ? "CRLF" : "无";
                        selected => {
                            if self.current-value == "CR" {
                                root.edit-ending = 0;
                            } else if self.current-value == "LF" {
                                root.edit-ending = 1;
                            } else if self.current-value == "CRLF" {
                                root.edit-ending = 2;
                            } else {
                                root.edit-ending = 3;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: "取消";
                        height: Theme.control-height;
                        horizontal-stretch: 1;
                        clicked => { root.editing = false; }
                    }
                    Button {
                        text: "保存";
                        height: Theme.control-height;
                        horizontal-stretch: 1;
                        primary: true;
                        clicked => { root.confirm-edit(); }
                    }
                }
            }
        }
    }
}
