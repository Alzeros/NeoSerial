import { ListView, Button } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export struct CommandItemSlint {
    label: string,
    content: string,
    mode: int,
    ending: int,
    enabled: bool,
}

export struct CommandGroupSlint {
    name: string,
    items: [CommandItemSlint],
}

export component ScriptPanel inherits Rectangle {
    background: Theme.panel;
    min-width: 300px;

    in-out property <[CommandGroupSlint]> groups;
    in-out property <int> current-group: 0;

    callback send-command(int, int);   // group 索引, item 索引
    callback add-command();
    callback edit-command(int, int);
    callback delete-command(int, int);

    VerticalLayout {
        spacing: 0px;

        // 标题栏
        Rectangle {
            height: 26px;
            background: Theme.panel-light;
            border-color: Theme.border;
            border-width: 1px;
            Text {
                text: "命令脚本";
                color: Theme.text-muted;
                x: 8px;
                vertical-alignment: center;
                font-size: Theme.font-ui-size;
            }
        }

        // Tab 栏（多 Group 预留，本轮单 Tab 也渲染）
        HorizontalLayout {
            spacing: 0px;
            for g[i] in root.groups : Rectangle {
                width: 80px;
                height: 28px;
                background: i == root.current-group ? Theme.bg : Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: g.name;
                    color: i == root.current-group ? #ffffff : Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.font-ui-size;
                }
                TouchArea {
                    clicked => { root.current-group = i; }
                }
            }
            Rectangle { horizontal-stretch: 1; background: Theme.panel; border-width: 1px; border-color: Theme.border; }
        }

        // 分隔线
        Rectangle { height: 1px; background: Theme.border; }

        // 命令列表
        ListView {
            vertical-stretch: 1;
            for g[gi] in root.groups : Rectangle {
                if gi == root.current-group : Rectangle {
                    for item[ii] in g.items : Rectangle {
                        height: 34px;
                        width: 100%;
                        background: Math.mod(ii, 2) == 0 ? Theme.panel : Theme.panel-alt;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 4px;
                            Button {
                                height: Theme.control-height;
                                text: item.label;
                                horizontal-stretch: 1;
                                primary: true;
                                clicked => { root.send-command(gi, ii); }
                            }
                            Button {
                                height: Theme.control-height;
                                text: "✎";
                                width: 24px;
                                clicked => { root.edit-command(gi, ii); }
                            }
                            Button {
                                height: Theme.control-height;
                                text: "✕";
                                width: 24px;
                                clicked => { root.delete-command(gi, ii); }
                            }
                        }
                    }
                }
            }
        }

        // 底部新增
        Rectangle {
            height: 34px;
            background: Theme.panel-light;
            border-color: Theme.border;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                alignment: center;
                Button {
                    height: Theme.control-height;
                    text: "+ 新增命令";
                    clicked => { root.add-command(); }
                }
            }
        }
    }
}
