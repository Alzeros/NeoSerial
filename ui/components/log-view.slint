import { ListView } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";
import { LogLine } from "connection-bar.slint";

export component LogView inherits Rectangle {
    background: Theme.log-bg;   // 白底

    in property <[LogLine]> log-model;
    in property <bool> paused;

    log-list := ListView {
        y: 0;
        height: 100%;
        width: 100%;

        for line[i] in root.log-model: Rectangle {
            height: 22px;
            width: 100%;
            background: transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    text: line.ts;
                    color: Theme.log-muted;
                    font-size: Theme.font-mono-size;
                    font-family: Theme.font-mono;
                    // 固定宽容下 HH:MM:SS.mmm；为空时不占宽
                    width: line.ts == "" ? 0px : 96px;
                    vertical-alignment: center;
                }
                Text {
                    text: line.tag;
                    color: line.color;
                    font-size: Theme.font-mono-size;
                    font-family: Theme.font-mono;
                    // 固定宽对齐（[发送]/[接收] 等宽对齐）
                    width: 52px;
                    vertical-alignment: center;
                }
                Text {
                    text: line.text;
                    color: line.color;
                    font-size: Theme.font-mono-size;
                    font-family: Theme.font-mono;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.paused: Text {
        x: 16px; y: 8px;
        text: "已暂停（后台继续接收）";
        color: Theme.log-error;
    }
}
