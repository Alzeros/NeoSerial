import { Theme } from "../styles/theme.slint";

/// 紧凑互斥按钮组。options 为选项文本列表，current 为当前选中索引。
export component SegButton inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback selected(int);

    HorizontalLayout {
        spacing: 0px;
        for opt[i] in root.options : Rectangle {
            width: self.preferred-width;
            background: i == root.current ? Theme.accent : Theme.btn-neutral;
            border-width: 1px;
            border-color: Theme.bg;
            Text {
                text: opt;
                color: i == root.current ? #ffffff : #d0d7de;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 11px;
            }
            TouchArea {
                clicked => { root.selected(i); }
            }
        }
    }
}
