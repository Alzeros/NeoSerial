import { Button, ComboBox } from "std-widgets.slint";
import { Theme } from "../styles/theme.slint";

export struct LogLine {
    ts: string,
    tag: string,
    text: string,
    color: color,
    dir: int,
}

export struct QuickCmd {
    label: string,
    content: string,
    mode: int,
    ending: int,
}

export component ConnectionBar inherits Rectangle {
    height: 110px;
    background: Theme.panel;

    in property <string> status-text;
    in property <color> status-color;
    in property <[string]> ports;
    in property <string> port-name;
    in property <int> baud-rate;
    in property <bool> connected;

    in-out property <int> data-bits: 8;
    in-out property <string> parity: "None";
    in-out property <string> stop-bits: "One";
    in-out property <string> flow-control: "None";

    callback port-selected(string);
    callback baud-changed(int);
    callback data-bits-changed(int);
    callback parity-changed(string);
    callback stop-bits-changed(string);
    callback flow-control-changed(string);
    callback open-clicked();
    callback close-clicked();

    VerticalLayout {
        spacing: 0px;

        // 标题栏
        Rectangle {
            height: 24px;
            background: Theme.panel-light;
            Text {
                x: 8px;
                text: "会话配置";
                color: Theme.text-muted;
                vertical-alignment: center;
                font-size: Theme.font-ui-size;
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Theme.border;
            }
        }

        // 主体：左侧两行网格 + 右侧按钮区
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 18px;
            padding-bottom: 4px;
            spacing: 12px;

            // ===== 左侧：两行六列网格 =====
            GridLayout {
                spacing: 4px;

                Row {
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "COM"; width: 40px; horizontal-alignment: right; color: Theme.text-muted; vertical-alignment: center; height: Theme.control-height; font-size: Theme.font-ui-size; }
                        ComboBox { height: Theme.control-height; width: 90px; model: root.ports; current-value: root.port-name; selected => { root.port-selected(self.current-value); } }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Baud"; width: 40px; horizontal-alignment: right; color: Theme.text-muted; vertical-alignment: center; height: Theme.control-height; font-size: Theme.font-ui-size; }
                        ComboBox { height: Theme.control-height; width: 90px; model: ["9600", "19200", "38400", "57600", "115200", "230400", "460800", "921600"]; current-value: "\{root.baud-rate}"; selected => { root.baud-changed(Math.round(self.current-value.to-float())); } }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "数据位"; width: 40px; horizontal-alignment: right; color: Theme.text-muted; vertical-alignment: center; height: Theme.control-height; font-size: Theme.font-ui-size; }
                        ComboBox { height: Theme.control-height; width: 90px; model: ["5", "6", "7", "8"]; current-value: "\{root.data-bits}"; selected => { root.data-bits-changed(self.current-value.to-float()); } }
                    }
                }

                Row {
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "校验"; width: 40px; horizontal-alignment: right; color: Theme.text-muted; vertical-alignment: center; height: Theme.control-height; font-size: Theme.font-ui-size; }
                        ComboBox { height: Theme.control-height; width: 90px; model: ["None", "Odd", "Even"]; current-value: root.parity; selected => { root.parity-changed(self.current-value); } }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "停止位"; width: 40px; horizontal-alignment: right; color: Theme.text-muted; vertical-alignment: center; height: Theme.control-height; font-size: Theme.font-ui-size; }
                        ComboBox { height: Theme.control-height; width: 90px; model: ["One", "Two"]; current-value: root.stop-bits; selected => { root.stop-bits-changed(self.current-value); } }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "流控"; width: 40px; horizontal-alignment: right; color: Theme.text-muted; vertical-alignment: center; height: Theme.control-height; font-size: Theme.font-ui-size; }
                        ComboBox { height: Theme.control-height; width: 90px; model: ["None", "Software", "Hardware"]; current-value: root.flow-control; selected => { root.flow-control-changed(self.current-value); } }
                    }
                }
            }

            // ===== 右侧：按钮区 + 状态 =====
            VerticalLayout {
                spacing: 12px;

                Button {
                    text: root.connected ? "关闭" : "打开";
                    height: 34px;
                    width: 80px;
                    clicked => {
                        if root.connected {
                            root.close-clicked();
                        } else {
                            root.open-clicked();
                        }
                    }
                    primary: !root.connected;
                }

                HorizontalLayout {
                    spacing: 4px;
                    padding-left: 4px;
                    Text {
                        text: root.connected ? "●" : "○";
                        color: root.connected ? Theme.status-on : Theme.status-off;
                        vertical-alignment: center;
                        font-size: Theme.font-ui-size;
                    }
                    Text {
                        text: root.status-text;
                        color: root.connected ? Theme.status-on : Theme.status-off;
                        vertical-alignment: center;
                        font-size: Theme.font-ui-size;
                    }
                }
            }
        }
    }

    // 外框底部分隔线
    Rectangle {
        y: root.height - 1px;
        height: 1px;
        width: 100%;
        background: Theme.border;
    }
}
