// NeoSerial 主题令牌 —— 工业研发工具风格（紧凑 / 直角 / 深灰）
// 所有组件从此处取色与尺寸，禁止硬编码魔法数字。

export global Theme {
    // 背景层级
    out property <color> bg: #0d1117;          // 最深底
    out property <color> panel: #161b22;       // 面板
    out property <color> panel-alt: #1c2128;   // 斑马纹
    out property <color> panel-light: #21262d; // 标题栏/工具条

    // 边框
    out property <color> border: #30363d;
    out property <color> divider: #21262d;

    // 日志区：白底黑字
    out property <color> log-bg: #ffffff;
    out property <color> log-rx: #1f2328;      // 接收：近黑
    out property <color> log-tx: #1a7f37;      // 发送：深绿（白底可辨）
    out property <color> log-error: #cf222e;   // 错误：红
    out property <color> log-muted: #6e7681;   // 时间戳/tag：灰

    // 文字（面板区）
    out property <color> text: #e6edf3;
    out property <color> text-muted: #8b949e;
    out property <color> text-error: #ff7b72;
    out property <color> text-rx: #c8d3e0;
    out property <color> text-tx: #7ee787;

    // 方向色（状态/标签）
    out property <color> rx: #7ee787;   // 绿
    out property <color> tx: #58a6ff;   // 蓝
    out property <color> sys: #d2a8ff;  // 紫
    out property <color> err: #ff7b72;  // 红

    // 强调 / 按钮
    out property <color> accent: #1f6feb;
    out property <color> btn-primary: #2f6fd6;
    out property <color> btn-neutral: #21262d;
    out property <color> btn-hover: #30363d;
    out property <color> btn-neutral-hover: #30363d;
    out property <color> btn-danger: #da3633;

    // 状态
    out property <color> status-on: #3fb950;   // 绿
    out property <color> status-off: #ff7b72;  // 红

    // 字体（Windows 中文优先清晰系统字体；字号略加大避免糊）
    // Microsoft YaHei UI 在 Win10/11 上对中文小字号抗锯齿最好
    out property <string> font-ui: "Microsoft YaHei UI";
    // 等宽：Cascadia Mono 优先，缺省回退 Consolas（由系统字体匹配）
    out property <string> font-mono: "Cascadia Mono";
    out property <length> font-ui-size: 13px;
    out property <length> font-mono-size: 13px;
    // 400 常规 / 600 半粗（避免 700 在小字号中文上发糊）
    out property <int> font-weight-normal: 400;
    out property <int> font-weight-semibold: 600;

    // 控件（字号 13px 时 28px 更不易裁切）
    out property <length> control-height: 28px;
    out property <length> toolbar-height: 32px;
    out property <length> radius: 0px;   // 直角，工业风
}
